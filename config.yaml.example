# 智能日报生成器配置文件
# 复制为 config.yaml 后按实际情况填写；所有密钥只允许通过环境变量注入

team:
  name: "研发一组"

# 团队成员身份映射：将 GitHub 与飞书两个命名空间按"人"聚合
# github 可留空（仅有飞书身份、无 GitHub 账号的成员）
members:
  - name: "张三"
    github: "zhangsan"
    lark: "zhangsan@company.com"
  - name: "李四"
    github: "lisi-dev"
    lark: "lisi@company.com"
  - name: "王五"
    github: "wangwu"
    lark: "wangwu@company.com"

# GitHub / GitHub Enterprise 数据采集
github:
  enabled: true
  base_url: "https://api.github.com"
  token_env: "GITHUB_TOKEN"        # 令牌从该环境变量读取
  repos:
    - "org/repo-a"
    - "org/repo-b"
  per_page: 30
  timeout: 10                     # 单次请求超时（秒）

# 飞书任务（当日任务清单读写）
lark_task:
  enabled: true
  app_id_env: "LARK_APP_ID"
  app_secret_env: "LARK_APP_SECRET"
  project_id: "proj_xxxxxxxx"
  # 自动为当天待完成计划创建「M月D日任务清单」（需 task:task:write 权限）
  auto_create_tasklist: true
  timeout: 10

# 飞书群消息采集
lark_message:
  enabled: true
  app_id_env: "LARK_APP_ID"
  app_secret_env: "LARK_APP_SECRET"
  chat_id: "oc_xxxxxxxx"
  chat_name: "研发群"          # 群显示名，用于日报正文
  # 仅保留包含以下任一关键词的消息
  keywords: ["上线", "bug", "需求", "联调", "发布", "阻塞", "review"]
  # 「问题与解决」板块自动提取关键词：含以下任一词的群消息进入问题板块（与协作沟通自动去重）
  issue_keywords: ["问题", "阻塞", "报错", "失败", "bug"]
  # 「明日计划」捕捉关键词：消息以前导词布置计划（如「明天：写周报」）落库，次日进任务清单
  plan_keywords: ["计划", "明天", "明日", "待办"]
  # 完成宣告关键词：群内发「完成 xxx」自动打勾当日清单子任务（优先于计划判定）
  done_keywords: ["完成", "做完", "搞定"]
  # 敏感词黑名单：命中即过滤，不进入日报
  sensitive_words: ["薪资", "工资", "绩效", "裁员", "辞退"]
  timeout: 10

# 邮件推送（HTML 日报）
email:
  enabled: true
  smtp_host: "smtp.company.com"
  smtp_port: 465
  use_ssl: true
  username_env: "SMTP_USERNAME"
  password_env: "SMTP_PASSWORD"
  sender: "report@company.com"
  recipients:
    - "leader@company.com"

# 飞书机器人推送（Markdown 日报）
lark_bot:
  enabled: true
  webhook: "https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx"
  chat_id: "oc_xxxxxxxx"
  timeout: 10

# AI 日报摘要（可选）：调用 OpenAI 兼容接口生成「今日总结」附在日报头部。
# 未启用 / 未配置 API Key / 接口失败时自动跳过，不影响日报生成（优雅降级）。
# 国内可直连的供应商：DeepSeek（https://api.deepseek.com/v1）、
# 通义（https://dashscope.aliyuncs.com/compatible-mode/v1）、
# 智谱 GLM（https://open.bigmodel.cn/api/paas/v4）；API Key 从环境变量读取。
ai:
  enabled: false
  base_url: "https://api.deepseek.com/v1"
  model: "deepseek-chat"
  api_key_env: "DEEPSEEK_API_KEY"
  timeout: 60
  max_tokens: 800

# 日报网页归档（可选）：每天日报推送后自动归档到 GitHub Pages（gh-pages 分支），
# 老师打开固定网址即可按日期浏览全部历史日报。仓库 token（token_env 对应的
# 环境变量）需 contents:write 权限；归档失败只记日志，不影响日报推送。
archive:
  enabled: false
  repo: "org/repo.github.io"      # 归档目标仓库（gh-pages 分支，勿用 main 以免污染采集）
  branch: "gh-pages"
  token_env: "GITHUB_TOKEN"
  timeout: 15

# 日报历史存储
storage:
  sqlite_path: "data/reports.db"

# 看板配置
dashboard:
  # 看板服务端口：默认 8000，网址固定为 http://127.0.0.1:8000/ 便于收藏；
  # 被其他程序占用时可改成别的端口。
  port: 8000
  # 看板账号与成员绑定（数据隔离）：键为成员名（须与 members.name 完全一致），
  # 值为该成员的看板账号名（多个账号可写列表 ["a", "b"]）。
  # 未出现在映射中的账号登录后看板为空，且不能添加/删除手动条目。
  member_accounts:
    张三: zhangsan

# 工作日与调度
schedule:
  # 额外节假日（YYYY-MM-DD）；周末始终跳过；安装 chinesecalendar 后法定节假日自动识别
  holidays: []
  # 调休上班日（YYYY-MM-DD）
  workdays: []
